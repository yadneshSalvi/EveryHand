{
  "name": "every-hand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5174"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
